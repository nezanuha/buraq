---
import Default from '@astrojs/starlight/components/Banner.astro';
import { versionForId, currentEquivalentOf, currentVersion } from '../versions.mjs';

/**
 * Starlight's Banner, plus an outdated-version notice.
 *
 * On an archived page this tells the reader they are not on current docs and
 * links to the same page in the latest version. That's the main UX and SEO
 * signal that keeps old versions from being mistaken for current ones.
 *
 * The matching `rel=canonical` is emitted in src/components/Head.astro.
 */
const route = Astro.locals.starlightRoute;
const version = versionForId(route?.entry?.id ?? '');
const latestHref = version ? currentEquivalentOf(route.entry.id, version.slug) : null;
---

<Default />

{
  version && (
    <div class="bq-outdated" role="note">
      <p>
        You are reading the <strong>{version.label}</strong> documentation.
        The latest release is <strong>{currentVersion.label}</strong>.
        {' '}
        <a href={latestHref}>View this page in the latest docs →</a>
      </p>
    </div>
  )
}

<style>
  .bq-outdated {
    background: color-mix(in srgb, var(--sl-color-orange, #f59e0b) 12%, transparent);
    border: 1px solid color-mix(in srgb, var(--sl-color-orange, #f59e0b) 40%, transparent);
    border-radius: var(--bq-radius, 0.625rem);
    padding: 0.75rem 1rem;
    margin-bottom: 1.5rem;
  }

  .bq-outdated p {
    margin: 0;
    font-size: 0.875rem;
    line-height: 1.6;
    color: var(--sl-color-white);
  }

  .bq-outdated a {
    color: var(--sl-color-white);
    font-weight: 600;
    text-underline-offset: 0.2em;
    white-space: nowrap;
  }
</style>
