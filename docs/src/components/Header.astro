---
import config from 'virtual:starlight/user-config';

import LanguageSelect from 'virtual:starlight/components/LanguageSelect';
import Search from 'virtual:starlight/components/Search';
import SiteTitle from 'virtual:starlight/components/SiteTitle';
import SocialIcons from 'virtual:starlight/components/SocialIcons';
import ThemeSelect from 'virtual:starlight/components/ThemeSelect';
import VersionPicker from './VersionPicker.astro';

const shouldRenderSearch =
  config.pagefind || config.components.Search !== '@astrojs/starlight/components/Search.astro';

const NAV = [
  { label: 'Docs',      href: '/docs/getting-started/installation' },
  { label: 'Tutorial',  href: '/docs/tutorial' },
  { label: 'Topics',    href: '/docs/topics/orm/models' },
  { label: 'Reference', href: '/docs/reference/orm' },
];
---

<div class="header-content bq-header">
  <div class="header-start">
    <SiteTitle />
  </div>

  <div class="header-center">
    <nav class="navbar bq-header-nav" aria-label="Main navigation">
      <ul class="navbar-list gap-x-6">
        {NAV.map((item) => (
          <li>
            <a class="link link-xs link-hover" href={item.href}>{item.label}</a>
          </li>
        ))}
      </ul>
    </nav>
  </div>

  <div class="header-end">
    {shouldRenderSearch && (
      <div class="bq-header-search print:hidden">
        <Search />
      </div>
    )}

    <div class="bq-header-actions print:hidden">
      <VersionPicker />
      <div class="sl-flex social-icons">
        <SocialIcons />
      </div>
      <ThemeSelect />
      <LanguageSelect />
    </div>

    {/*
      Below the width where the nav links and the actions fit, both were simply
      not rendered -- and Starlight's own mobile menu only exists on pages with
      a sidebar. So on the splash page a phone had no navigation and no way to
      change the theme at all.
    */}
    <details class="bq-header-menu print:hidden">
      <summary aria-label="Menu">
        <svg viewBox="0 0 24 24" width="20" height="20" fill="none"
             stroke="currentColor" stroke-width="2" stroke-linecap="round"
             aria-hidden="true">
          <path d="M4 7h16M4 12h16M4 17h16" />
        </svg>
      </summary>

      <div class="bq-header-menu__panel">
        <nav aria-label="Site">
          <ul>
            {NAV.map((item) => (
              <li><a href={item.href}>{item.label}</a></li>
            ))}
          </ul>
        </nav>

        <div class="bq-header-menu__prefs">
          <ThemeSelect />
          <VersionPicker />
          <div class="sl-flex social-icons"><SocialIcons /></div>
        </div>
      </div>
    </details>
  </div>
</div>

<script>
  /* A <details> menu stays open until something closes it, and a menu that
     survives the click that dismissed it reads as broken. The page-actions menu
     in PageTitle.astro handles its own; this one is a different element. */
  const closeMenus = (except?: EventTarget | null) => {
    for (const menu of document.querySelectorAll('details.bq-header-menu[open]')) {
      if (!except || !menu.contains(except as Node)) menu.removeAttribute('open');
    }
  };

  document.addEventListener('click', (event) => closeMenus(event.target));

  document.addEventListener('keydown', (event) => {
    if (event.key !== 'Escape') return;
    closeMenus();
    // Focus goes back to the control that opened it, or it lands at the top of
    // the page and a keyboard user has to tab all the way down again.
    const open = document.querySelector('details.bq-header-menu > summary');
    if (open instanceof HTMLElement) open.focus();
  });

  /* Following a link inside the menu leaves it open behind the new page on a
     browser that restores scroll position rather than reloading. */
  document.addEventListener('pageshow', () => closeMenus());
</script>

<style>
  /* Starlight makes .header a 3-column grid at >=50rem, which would trap
     .header-content in column 1. Reset it so Frutjam's grid takes over. */
  :global(.page > .header) {
    display: block;
    padding-block: 0;
    /* Frutjam's .header sets height:3.5rem via --header-height; pin ours. */
    height: var(--sl-nav-height);
  }

  /* Starlight owns the horizontal padding (it accounts for the mobile menu
     button), so neutralise Frutjam's responsive padding-inline. */
  .bq-header.header-content {
    padding-inline: 0;
    gap: 1rem;
  }

  /* Nav links — hidden below lg, Starlight's sidebar covers mobile */
  .bq-header-nav {
    display: none;
  }

  .bq-header-nav :global(.link) {
    color: var(--sl-color-gray-3);
    font-weight: 500;
    white-space: nowrap;
    transition: color 0.16s var(--bq-ease, ease);
  }

  .bq-header-nav :global(.link:hover) {
    color: var(--sl-color-white);
  }

  @media (min-width: 64rem) {
    .bq-header-nav {
      display: flex;
    }
  }

  /* Search — give it real width instead of Frutjam's auto centre column */
  .bq-header-search {
    flex: 1;
    display: flex;
    justify-content: flex-end;
    max-width: 16rem;
  }

  .bq-header-search :global(site-search) {
    width: 100%;
  }

  .bq-header-search :global(button[data-open-modal]) {
    width: 100%;
  }

  .bq-header-actions {
    align-items: center;
    gap: 1rem;
  }

  .social-icons {
    align-items: center;
    gap: 0.75rem;
  }

  .social-icons::after {
    content: '';
    height: 1.5rem;
    border-inline-end: 1px solid var(--sl-color-hairline);
  }

  /* ── Mobile menu ─────────────────────────────────────────────────────────
     One control holding what the header cannot fit: the nav links, the theme
     toggle, the version picker and the social links. Starlight's own mobile
     menu carries the page sidebar and only exists where there is one, so the
     splash page had nothing. */

  .bq-header-menu {
    position: relative;
  }

  /* The disclosure triangle would sit beside an icon already saying the same. */
  .bq-header-menu > summary {
    list-style: none;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.25rem;
    height: 2.25rem;
    border: 1px solid var(--sl-color-hairline);
    border-radius: var(--bq-radius-sm, 0.375rem);
    color: var(--sl-color-gray-2);
    cursor: pointer;
  }

  .bq-header-menu > summary::-webkit-details-marker {
    display: none;
  }

  .bq-header-menu > summary:hover {
    color: var(--sl-color-white);
    background: var(--sl-color-gray-7);
  }

  .bq-header-menu__panel {
    position: absolute;
    inset-inline-end: 0;
    top: calc(100% + 0.5rem);
    z-index: 50;
    min-width: 12rem;
    padding: 0.5rem;
    border: 1px solid var(--sl-color-hairline);
    border-radius: var(--bq-radius-md, 0.5rem);
    /* Opaque: the panel sits over page content, and the header's translucency
       is for the bar itself, not for a menu you are trying to read. */
    background: var(--sl-color-bg);
    box-shadow: var(--bq-shadow-md, 0 8px 24px rgb(0 0 0 / 0.12));
  }

  .bq-header-menu__panel ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .bq-header-menu__panel a {
    display: block;
    padding: 0.5rem 0.625rem;
    border-radius: var(--bq-radius-sm, 0.375rem);
    color: var(--sl-color-gray-2);
    font-size: 0.9rem;
    text-decoration: none;
  }

  .bq-header-menu__panel a:hover {
    background: var(--sl-color-gray-6);
    color: var(--sl-color-white);
  }

  .bq-header-menu__prefs {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-top: 0.5rem;
    padding-top: 0.625rem;
    border-top: 1px solid var(--sl-color-hairline);
  }

  /* ── What shows at which width ───────────────────────────────────────────
     Below 64rem the nav links and the action row are hidden and the menu
     carries them; at 64rem and above the header has room and the menu goes. */

  .bq-header-actions {
    display: none;
  }

  @media (min-width: 64rem) {
    .bq-header-actions {
      display: flex;
    }

    .bq-header-menu {
      display: none;
    }
  }

  /* Narrow screens: search takes the room the nav links are not using, but
     leaves the menu its corner. */
  @media (max-width: 63.99rem) {
    .bq-header-search {
      max-width: none;
    }
  }

  /* Under about 30rem the search field and the menu compete; the field keeps a
     usable width and the title truncates instead. */
  @media (max-width: 30rem) {
    .bq-header.header-content {
      gap: 0.5rem;
    }

    .bq-header-search {
      min-width: 0;
    }
  }
</style>
