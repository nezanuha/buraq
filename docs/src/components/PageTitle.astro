---
/**
 * The page title, plus actions for reading this page somewhere other than here.
 *
 * "Copy page" and "Markdown" both use the raw Markdown published at this page's
 * URL plus `.md`; "Open in AI" hands an assistant that same address rather than
 * pasting the text into a query string, which would truncate on longer pages.
 */
import { Icon } from '@astrojs/starlight/components';

// Taken from the route rather than the entry: the content layer has no `slug`,
// and the pathname is what the .md endpoint is published under anyway.
const markdownUrl = new URL(`${Astro.url.pathname}.md`, Astro.site).href;

// The splash template carries its own hero heading, so rendering this one gives
// the home page two <h1> elements and an actions bar pointing at a page that was
// never published as Markdown.
const isSplash = Astro.locals.starlightRoute.entry.data.template === 'splash';

const prompt = `Read ${markdownUrl} and help me with it.`;
const q = encodeURIComponent(prompt);

const assistants = [
  { name: 'Claude', href: `https://claude.ai/new?q=${q}` },
  { name: 'ChatGPT', href: `https://chatgpt.com/?q=${q}` },
  { name: 'Perplexity', href: `https://www.perplexity.ai/search?q=${q}` },
  { name: 'v0', href: `https://v0.dev/chat?q=${q}` },
  { name: 'Scira', href: `https://scira.ai/?q=${q}` },
];
---

{!isSplash && (
<div class="bq-page-head">
  <h1 id="_top">{Astro.locals.starlightRoute.entry.data.title}</h1>

  <div class="bq-actions" data-markdown-url={markdownUrl}>
    <button type="button" class="bq-action" data-copy-page>
      {/*
        Inline rather than <Icon name="copy" />: Starlight ships no `copy`
        icon, and an unknown name renders an empty <svg> -- no error, no
        warning, just a button with a gap where its icon should be. The other
        three here (open-book, down-caret, document) are real names and work.

        Drawn on the same 24x24 grid as Starlight's own so it sits at the same
        weight beside them.
      */}
      <svg
        class="bq-action__icon" viewBox="0 0 24 24" width="16" height="16"
        fill="none" stroke="currentColor" stroke-width="2"
        stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"
      >
        <rect x="9" y="9" width="11" height="11" rx="2" />
        <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1" />
      </svg>
      <span data-copy-label>Copy page</span>
    </button>

    <details class="bq-menu">
      {/*
        The labels are wrapped so they can be hidden on a narrow screen. They
        were bare text nodes, and the rule meant to hide them selects a span --
        so it matched nothing and the row ran off the side of the page instead.
        aria-label carries the name once the text is not shown.
      */}
      <summary class="bq-action" aria-label="Open in AI">
        <Icon name="open-book" size="0.85em" />
        <span>Open in AI</span>
        <Icon name="down-caret" size="0.85em" class="bq-menu__caret" />
      </summary>
      <ul class="bq-menu__list">
        {assistants.map((a) => (
          <li>
            <a href={a.href} target="_blank" rel="noopener noreferrer">{a.name}</a>
          </li>
        ))}
      </ul>
    </details>

    <a class="bq-action" href={markdownUrl} rel="nofollow" aria-label="View as Markdown">
      <Icon name="document" size="0.85em" />
      <span>Markdown</span>
    </a>
  </div>
</div>
)}

<script>
  document.addEventListener('click', async (event) => {
    const target = event.target as HTMLElement;
    const button = target.closest('[data-copy-page]') as HTMLButtonElement | null;

    // Close any open menu when the click landed outside it.
    for (const menu of document.querySelectorAll('details.bq-menu[open]')) {
      if (!menu.contains(target)) menu.removeAttribute('open');
    }

    if (!button) return;

    const url = button.closest('.bq-actions')?.getAttribute('data-markdown-url');
    const label = button.querySelector('[data-copy-label]');
    if (!url || !label) return;

    const previous = label.textContent;
    try {
      const response = await fetch(url);
      if (!response.ok) throw new Error(String(response.status));
      await navigator.clipboard.writeText(await response.text());
      label.textContent = 'Copied';
    } catch {
      // A denied clipboard permission or an offline page should say so rather
      // than look like nothing happened.
      label.textContent = 'Copy failed';
    }
    setTimeout(() => { label.textContent = previous; }, 2000);
  });

  // Escape closes the menu, as a menu should.
  document.addEventListener('keydown', (event) => {
    if (event.key !== 'Escape') return;
    for (const menu of document.querySelectorAll('details.bq-menu[open]')) {
      menu.removeAttribute('open');
    }
  });
</script>
