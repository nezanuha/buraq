---
import EditLink from '@astrojs/starlight/components/EditLink.astro';
import LastUpdated from '@astrojs/starlight/components/LastUpdated.astro';
import Pagination from '@astrojs/starlight/components/Pagination.astro';

const COLUMNS = [
  {
    title: 'Getting Started',
    links: [
      { label: 'Installation',      href: '/docs/getting-started/installation' },
      { label: 'Quickstart',        href: '/docs/getting-started/quickstart' },
      { label: 'Project Structure', href: '/docs/getting-started/project-structure' },
      { label: 'Settings',          href: '/docs/getting-started/settings' },
    ],
  },
  {
    title: 'Topics',
    links: [
      { label: 'ORM',            href: '/docs/topics/orm/models' },
      { label: 'Views',          href: '/docs/topics/views/function-based' },
      { label: 'Forms',          href: '/docs/topics/forms/overview' },
      { label: 'Authentication', href: '/docs/topics/authentication' },
      { label: 'Admin',          href: '/docs/topics/admin' },
    ],
  },
  {
    title: 'Reference',
    links: [
      { label: 'ORM API',              href: '/docs/reference/orm' },
      { label: 'Views API',            href: '/docs/reference/views' },
      { label: 'Forms API',            href: '/docs/reference/forms' },
      { label: 'Migrating from Django', href: '/docs/migrating-from-django' },
      { label: 'Deployment',           href: '/docs/deployment/overview' },
    ],
  },
];

const year = new Date().getFullYear();
---

{/* In-page footer: edit link, last updated, prev/next */}
<footer class="sl-flex bq-inpage-footer">
  <div class="meta sl-flex">
    <EditLink />
    <LastUpdated />
  </div>
  <Pagination />
</footer>

{/* Site-wide footer — Frutjam footer component */}
<div class="bq-site-footer">
  <div class="bq-site-footer__inner">
  <footer class="footer lg:footer-horizontal bq-footer-main">
    <div class="bq-footer-brand">
      <a href="/" class="bq-footer-logo">Buraq</a>
      <p class="bq-footer-tagline">
        The async Python framework you already know how to use.
      </p>
      <a
        class="link link-hover link-xs bq-footer-gh"
        href="https://github.com/nezanuha/buraq"
      >
        <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M12 .3a12 12 0 0 0-3.8 23.38c.6.12.83-.26.83-.57L9 21.07c-3.34.72-4.04-1.61-4.04-1.61-.55-1.39-1.34-1.76-1.34-1.76-1.08-.74.09-.73.09-.73 1.2.09 1.83 1.24 1.83 1.24 1.08 1.83 2.81 1.3 3.5 1 .1-.78.42-1.31.76-1.61-2.67-.3-5.47-1.33-5.47-5.93 0-1.31.47-2.38 1.24-3.22-.14-.3-.54-1.52.1-3.18 0 0 1-.32 3.3 1.23a11.5 11.5 0 0 1 6 0c2.28-1.55 3.29-1.23 3.29-1.23.64 1.66.24 2.88.12 3.18a4.65 4.65 0 0 1 1.23 3.22c0 4.61-2.8 5.63-5.48 5.92.42.36.81 1.1.81 2.22l-.01 3.29c0 .31.2.69.82.57A12 12 0 0 0 12 .3Z"/>
        </svg>
        GitHub
      </a>
    </div>

    {COLUMNS.map((col) => (
      <div>
        <span class="footer-title">{col.title}</span>
        {col.links.map((l) => (
          <a class="link link-hover link-xs" href={l.href}>{l.label}</a>
        ))}
      </div>
    ))}
  </footer>

  <div class="bq-footer-bottom">
    <span>© {year} Nezanuha · MIT License</span>
    <span>
      Built with <a class="link link-hover link-xs" href="https://starlight.astro.build">Starlight</a>
    </span>
  </div>
  </div>
</div>

<style>
  /* ── In-page footer (unchanged Starlight behaviour) ── */
  .bq-inpage-footer {
    flex-direction: column;
    gap: 1.5rem;
  }

  .meta {
    gap: 0.75rem 3rem;
    justify-content: space-between;
    flex-wrap: wrap;
    margin-top: 3rem;
    font-size: var(--sl-text-sm);
    color: var(--sl-color-gray-3);
  }

  .meta > :global(p:only-child) {
    margin-inline-start: auto;
  }

  /* ── Site footer shell ──
     The divider spans full width; the content sits in its own container so it
     never depends on the parent panel's padding (the splash/home layout zeroes
     it to let the hero go edge-to-edge). */
  .bq-site-footer {
    margin-top: 4.5rem;
    padding-top: 3rem;
    border-top: 1px solid var(--sl-color-hairline);
  }

  .bq-site-footer__inner {
    /* Doc pages: already inside a padded .sl-container, so no extra inset.
       Home page overrides this with a max-width container (see custom.css). */
    width: 100%;
  }

  /* Frutjam .footer is a grid; give the brand column more room on desktop */
  .bq-footer-main {
    row-gap: 2.5rem;
    column-gap: 3rem;
  }

  @media (min-width: 64rem) {
    .bq-footer-main {
      grid-template-columns: 1.6fr repeat(3, minmax(0, 1fr));
    }
  }

  @media (min-width: 40rem) and (max-width: 63.99rem) {
    .bq-footer-main {
      grid-auto-flow: row;
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  /* ── Brand column ── */
  .bq-footer-brand {
    gap: 0.7rem;
  }

  .bq-footer-logo {
    font-size: 1.05rem;
    font-weight: 700;
    letter-spacing: -0.03em;
    color: var(--sl-color-white);
    text-decoration: none;
  }

  .bq-footer-tagline {
    font-size: 0.83rem;
    line-height: 1.6;
    color: var(--sl-color-gray-3);
    max-width: 19rem;
    margin: 0;
    text-wrap: pretty;
  }

  .bq-footer-gh {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    color: var(--sl-color-gray-3);
  }

  .bq-footer-gh:hover {
    color: var(--sl-color-white);
  }

  /* ── Frutjam footer-title override ── */
  .bq-footer-main :global(.footer-title) {
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.07em;
    color: var(--sl-color-gray-3);
    margin-bottom: 0.15rem;
  }

  /* ── Link columns ── */
  .bq-footer-main :global(.link) {
    color: var(--sl-color-gray-3);
    font-size: 0.845rem;
    line-height: 1.5;
    text-decoration: none;
    transition: color 0.16s var(--bq-ease, ease);
  }

  .bq-footer-main :global(.link:hover) {
    color: var(--sl-color-white);
  }

  /* ── Bottom bar ── */
  .bq-footer-bottom {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 0.5rem;
    margin-top: 3rem;
    padding-block: 1.5rem;
    border-top: 1px solid var(--sl-color-hairline);
    font-size: 0.79rem;
    color: var(--sl-color-gray-4);
  }

  .bq-footer-bottom :global(.link) {
    color: var(--sl-color-gray-3);
    font-size: 0.79rem;
    text-decoration: none;
  }

  .bq-footer-bottom :global(.link:hover) {
    color: var(--sl-color-white);
  }

  @media (max-width: 40rem) {
    .bq-footer-bottom {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
